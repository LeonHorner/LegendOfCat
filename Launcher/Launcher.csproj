<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(RuntimeIdentifier)' == 'win-x64'">WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>../tools/icon.ico</ApplicationIcon>
    <AssemblyName>LegendOfCat</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Game/Scripts/UpdatePolicy.cs" Link="UpdatePolicy.cs" />
    <Compile Include="../Assets/Game/Scripts/DownloadProgress.cs" Link="DownloadProgress.cs" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- Also package the mount-independent POSIX handoff supervisor. -->
    <None Update="linux-update-runner.sh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
